# =============================================================================
# Fazle Payroll Engine — Standalone Environment Configuration
# =============================================================================
# Copy this file to `.env` and edit the values for your deployment.
# Every value here is input-dependent — nothing is hard-coded in the app code.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string for asyncpg.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://azim:azim@localhost:5432/fazle_payroll

# -----------------------------------------------------------------------------
# 2. AUTHENTICATION (REQUIRED)
# -----------------------------------------------------------------------------
# API key sent as `X-Internal-Key` header on every /api/fpe/* request.
# Change this to a strong secret in production.
INTERNAL_API_KEY=your-internal-api-key-here

# -----------------------------------------------------------------------------
# 3. OLLAMA (OPTIONAL — for AI enhancement of low-confidence message parses)
# -----------------------------------------------------------------------------
# If you do not run Ollama, set OLLAMA_URL to an unreachable address; the app
# will still work — AI enhancement will simply be skipped on failure.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:3b

# -----------------------------------------------------------------------------
# 4. WHATSAPP BRIDGES (OPTIONAL — for Cash/Income command replies)
# -----------------------------------------------------------------------------
# Bridge HTTP endpoints. The app will attempt to send WhatsApp replies to these
# URLs. If a bridge is not running, send() returns False and accounting is not
# affected — only the reply is skipped.
BRIDGE1_URL=http://localhost:8082
BRIDGE2_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# 5. FPE PAYROLL SETTINGS (OPTIONAL)
# -----------------------------------------------------------------------------
# Comma-separated phone numbers authorized to send Cash/Income commands.
# Leave empty if you do not use command-based payroll.
FPE_CASH_AUTHORIZED_PHONES=
FPE_INCOME_AUTHORIZED_PHONES=

# Comma-separated target WhatsApp chat JIDs for historical sync.
# Example: 8801844836824@s.whatsapp.net
FPE_SYNC_CHAT_JIDS=

# Default accountant phone (used as fallback for sync target JID).
ACCOUNTANT_PHONE=

# -----------------------------------------------------------------------------
# 6. APP SETTINGS (OPTIONAL)
# -----------------------------------------------------------------------------
APP_PORT=8200
LOG_LEVEL=INFO
DEBUG=false
