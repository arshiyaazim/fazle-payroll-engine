# Fazle Payroll Engine — standalone environment
# Copy to .env and fill in values before running.

# ── Database (required) ──
DATABASE_URL=postgresql+asyncpg://azim:azim@localhost:5432/fazle_payroll

# ── Auth (required) ──
INTERNAL_API_KEY=your-internal-api-key-here

# ── Ollama (optional — for AI enhancement of low-confidence parses) ──
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hermes3:3b

# ── WhatsApp bridges (optional — for cash/income command replies) ──
BRIDGE1_URL=http://localhost:8082
BRIDGE2_URL=http://localhost:8081

# ── FPE payroll settings ──
# Phones authorized to send "Cash <phone> <name> <amount>" commands
FPE_CASH_AUTHORIZED_PHONES=
# Phones authorized to send "Income <phone> <name> <amount>" commands
FPE_INCOME_AUTHORIZED_PHONES=
# Comma-separated target chat JIDs for historical sync
FPE_SYNC_CHAT_JIDS=
ACCOUNTANT_PHONE=

# ── App ──
APP_PORT=8200
LOG_LEVEL=INFO
DEBUG=false
